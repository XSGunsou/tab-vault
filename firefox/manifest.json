{
  "manifest_version": 3,
  "name": "TabVault",
  "version": "1.0",
  "description": "Save tabs, attach notes, categorize groups, and set reminders.",
  "icons": {
    "128": "icon.png"
  },
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "notifications"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icon.png",
      "32": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Open TabVault"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tabvault@wireframe.com",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
